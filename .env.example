# Application
NODE_ENV=production
PORT=10000
API_VERSION=v1

# Database (Configurar en Render con credenciales de Neon)
DATABASE_HOST=your_neon_host
DATABASE_PORT=5432
DATABASE_USER=your_neon_user
DATABASE_PASSWORD=your_neon_password
DATABASE_NAME=your_neon_database
DATABASE_SSL=true

# JWT (Generar tokens aleatorios seguros)
JWT_SECRET=your_super_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_different_super_secure_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
